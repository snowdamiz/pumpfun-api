# PumpFun API Configuration
# Copy this file to .env and update with your values
# Based on proven working examples from basic-usage.ts

# API Configuration (matches working examples)
PUMPFUN_API_BASE_URL=https://frontend-api-v3.pump.fun
PUMPFUN_API_TIMEOUT=10000

# WebSocket Configuration (from working examples)
PUMPFUN_WS_URL=wss://api.pump.fun/ws

# Authentication (from working examples - for future use)
PUMPFUN_API_KEY=your_api_key_here
PUMPFUN_AUTH_TOKEN=your_auth_token_here

# Rate Limiting Configuration (matches working examples)
PUMPFUN_RATE_LIMIT_REQUESTS=60
PUMPFUN_RATE_LIMIT_WINDOW_MS=60000
PUMPFUN_RATE_LIMIT_RETRY_AFTER=true
PUMPFUN_RATE_LIMIT_SLIDING_WINDOW=true
PUMPFUN_RATE_LIMIT_BURST_PROTECTION=true
PUMPFUN_RATE_LIMIT_MAX_BURST=10
MAX_REQUESTS_PER_MINUTE=60
RATE_LIMIT_DELAY_MS=1000

# Retry Configuration
PUMPFUN_RETRY_MAX_RETRIES=3
PUMPFUN_RETRY_BASE_DELAY=1000
PUMPFUN_RETRY_MAX_DELAY=30000
PUMPFUN_RETRY_BACKOFF_FACTOR=2

# Discovery Settings (from working examples)
ENABLE_NETWORK_ANALYSIS=false
ENABLE_RESPONSE_LOGGING=true

# Logging Configuration (matches working examples)
PUMPFUN_LOG_LEVEL=INFO
PUMPFUN_LOG_CONSOLE=true
PUMPFUN_LOG_COLORS=true
PUMPFUN_LOG_FILE=false
PUMPFUN_LOG_FILE_PATH=./logs/pumpfun-api.log
LOG_LEVEL=info
LOG_FILE_PATH=./logs/discovery.log

# Development Settings (from working examples)
NODE_ENV=development
DEBUG=pumpfun:*
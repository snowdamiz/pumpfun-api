{
  "name": "@openworth/pump-api",
  "version": "1.0.0",
  "type": "module",
  "description": "TypeScript client library for PumpFun streaming data API",
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c && node scripts/fix-imports.js",
    "build:watch": "rollup -c -w",
    "dev": "npm run build:watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:performance": "jest --testPathPattern=performance",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test && npm run lint",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "docs:generate": "typedoc --out docs src/index.ts --excludePrivate --excludeInternal",
    "security:audit": "npm audit --audit-level moderate",
    "size:check": "npm run build && node scripts/analyze-bundle.js",
    "performance:test": "node scripts/performance-test.js",
    "ci": "npm run type-check && npm run lint && npm run test:coverage && npm run build && npm run performance:test"
  },
  "keywords": [
    "pumpfun",
    "api",
    "client",
    "typescript",
    "streaming",
    "cryptocurrency",
    "solana",
    "livestream",
    "video"
  ],
  "author": {
    "name": "Openworth"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/snowdamiz/pumpfun-api.git",
    "directory": "packages/api-client"
  },
  "bugs": {
    "url": "https://github.com/snowdamiz/pumpfun-api/issues"
  },
  "homepage": "https://github.com/snowdamiz/pumpfun-api/tree/main/packages/api-client#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.0.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "axios-mock-adapter": "^1.22.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.6.0",
    "jest-junit": "^16.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "livekit-client": "^2.15.10",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-dts": "^6.0.0",
    "ts-jest": "^29.1.0",
    "tslib": "^2.6.0",
    "typescript": "^5.2.0"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0",
    "livekit-client": "^2.15.10"
  },
  "peerDependenciesMeta": {
    "livekit-client": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "private": true,
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/openworth"
  }
}
